# Media (public/assets/img, public/assets/video) is tracked in git and served
# from the app bundle, so it must NOT be excluded here (2026-10 Vercel migration).

# Standard excludes (this project has no .gitignore fallback quirks, but
# .vercelignore replaces .gitignore entirely once it exists, so repeat them)
/node_modules
/.next
/out
/build
/projects
/assets
